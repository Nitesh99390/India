# ── Telegram credentials (https://my.telegram.org) ─────────────────
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_here

# ── Bot security ───────────────────────────────────────────────────
# Users must send this code once to unlock the bot.
SECURITY_CODE=ChangeMe@123
# 0 → the first user who unlocks the bot becomes the owner
OWNER_ID=0

# ── Backup forum group (bot must be admin with "Manage Topics") ────
BACKUP_GROUP_ID=-1001234567890
