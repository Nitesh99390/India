# ── Telegram credentials ───────────────────────────────────────────────
# https://my.telegram.org → API development tools
API_ID=123456
API_HASH=your_api_hash_here
# @BotFather → /newbot
BOT_TOKEN=123456:your_bot_token_here

# ── Access control (approval based; re-applied on every start, MongoDB keeps the rest) ──
# Your numeric Telegram ID → permanent owner who approves everyone. Send /id to the bot to find it.
OWNER_ID=0
# Optional: comma-separated IDs that are admins on every start (can approve / reject users)
ADMIN_USERS=
# Optional: comma-separated IDs with lifetime access on every start
AUTHORIZED_USERS=
# 1 → everyone is approved automatically (no requests needed)
PUBLIC_MODE=0
# Duration used by /approve <id> or /adduser <id> when none is given: 1w · 1m · 3m · 6m · 1y · forever · 45d
DEFAULT_APPROVAL=1m
# Remind users N days before their access expires (0 = off)
EXPIRY_REMINDER_DAYS=3
# Hours a rejected user must wait before requesting again (0 = none)
REJECT_COOLDOWN_H=24
# v4 users who unlocked with the old security code: keep (lifetime access) | reapprove
LEGACY_USERS=keep

# ── Optional backup forum group (bot must be admin with "Manage Topics") ─
# 0 → disabled
BACKUP_GROUP_ID=0

# ── Tuning (optional) ─────────────────────────────────────────────────
MAX_INPUT_MB=50
MAX_JOBS_PER_USER=2
CONCURRENCY=8
DEFAULT_LANG=hi
DEFAULT_FORMAT=txt
DEFAULT_SPLIT_KB=500

# ── MongoDB ───────────────────────────────────────────────────────────
# Empty → the project's built-in Atlas free-tier cluster (persistent, zero setup).
# Your own cluster: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
# "off" → fully in RAM (users / settings / stats reset on restart).
MONGO_URI=
MONGO_DB=noveltranslator
HISTORY_LIMIT=30
# Free-tier guard (Atlas M0 = 512 MB). Old job history is pruned above 80 % of the budget.
DB_BUDGET_MB=400
DB_MAX_JOB_DOCS=3000
DB_JOB_TTL_DAYS=60

# ── Telegram Mini App (served by the bot at /app) ─────────────────────
# Public HTTPS base URL of this service. On Render RENDER_EXTERNAL_URL is
# used automatically; set PUBLIC_URL elsewhere (Docker/VPS behind a proxy).
PUBLIC_URL=
# Override the full Mini App URL (default: PUBLIC_URL/app)
MINI_APP_URL=
# Local testing only: fake signed-in Telegram user id for http://localhost:PORT/app
MINIAPP_DEV_USER=0

# ── Master / worker deployment ────────────────────────────────────────
# SERVICE_ROLE is master for the polling service and worker for processors.
SERVICE_ROLE=master
WORKER_NODE_ID=worker-local
WORKER_HEARTBEAT_INTERVAL=30
WORKER_POLL_INTERVAL=3

# ── Render (set automatically by Render; only needed locally) ─────────
PORT=10000
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
KEEP_ALIVE=1
KEEP_ALIVE_INTERVAL=600
