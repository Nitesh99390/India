# ── Telegram credentials ───────────────────────────────────────────────
# https://my.telegram.org → API development tools
API_ID=123456
API_HASH=your_api_hash_here
# @BotFather → /newbot
BOT_TOKEN=123456:your_bot_token_here

# ── Access control (no database: these are re-applied on every start) ──
# Users must send this code once (per server restart) to unlock the bot
SECURITY_CODE=ChangeMe@123
# Your numeric Telegram ID → permanent owner. Send /id to the bot to find it.
OWNER_ID=0
# Optional: comma-separated IDs that are always authorised
AUTHORIZED_USERS=
# 1 → anyone can use the bot without a code
PUBLIC_MODE=0

# ── Optional backup forum group (bot must be admin with "Manage Topics") ─
# 0 → disabled
BACKUP_GROUP_ID=0

# ── Tuning (optional) ─────────────────────────────────────────────────
MAX_INPUT_MB=50
MAX_JOBS_PER_USER=2
CONCURRENCY=8
DEFAULT_LANG=hi
DEFAULT_FORMAT=txt
DEFAULT_SPLIT_KB=500

# ── Render (set automatically by Render; only needed locally) ─────────
PORT=10000
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
KEEP_ALIVE=1
KEEP_ALIVE_INTERVAL=600
