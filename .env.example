# ── Telegram credentials ───────────────────────────────────────────────
# https://my.telegram.org → API development tools
API_ID=123456
API_HASH=your_api_hash_here
# @BotFather → /newbot
BOT_TOKEN=123456:your_bot_token_here

# ── Access control (re-applied on every start; MongoDB keeps the rest) ──
# Users must send this code once to unlock the bot
SECURITY_CODE=ChangeMe@123
# Your numeric Telegram ID → permanent owner. Send /id to the bot to find it.
OWNER_ID=0
# Optional: comma-separated IDs that are always authorised
AUTHORIZED_USERS=
# 1 → anyone can use the bot without a code
PUBLIC_MODE=0

# ── Optional backup forum group (bot must be admin with "Manage Topics") ─
# 0 → disabled
BACKUP_GROUP_ID=0

# ── Tuning (optional) ─────────────────────────────────────────────────
MAX_INPUT_MB=50
MAX_JOBS_PER_USER=2
CONCURRENCY=8
DEFAULT_LANG=hi
DEFAULT_FORMAT=txt
DEFAULT_SPLIT_KB=500

# ── MongoDB (optional, recommended) ───────────────────────────────────
# MongoDB Atlas free tier works: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
# Without it the bot runs fully in RAM (users / settings / stats reset on restart).
MONGO_URI=
MONGO_DB=noveltranslator
HISTORY_LIMIT=30

# ── Telegram Mini App (served by the bot at /app) ─────────────────────
# Public HTTPS base URL of this service. On Render RENDER_EXTERNAL_URL is
# used automatically; set PUBLIC_URL elsewhere (Docker/VPS behind a proxy).
PUBLIC_URL=
# Override the full Mini App URL (default: PUBLIC_URL/app)
MINI_APP_URL=
# Local testing only: fake signed-in Telegram user id for http://localhost:PORT/app
MINIAPP_DEV_USER=0

# ── Render (set automatically by Render; only needed locally) ─────────
PORT=10000
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
KEEP_ALIVE=1
KEEP_ALIVE_INTERVAL=600
